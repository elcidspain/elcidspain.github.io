{
  "schema": "aumara.global-descent-runtime",
  "capture_mode": "LIVE_BROWSER_RUNTIME",
  "provider": "GOOGLE_PHOTOREALISTIC_3D_TILES",
  "loader": "Cesium.createGooglePhotorealistic3DTileset()",
  "globalTilesStatus": "BLOCKED_ION_TOKEN",
  "ionSessionToken": false,
  "ionDefaultTokenPresent": true,
  "ionRequestStatus": 401,
  "firstGoogleTileRendered": false,
  "attributionVisible": true,
  "continuousCamera": true,
  "parcelClippingActive": false,
  "localTwinLoaded": true,
  "blendComplete": false,
  "esri_used": false,
  "drive_secret_search": false,
  "public_url_token": false,
  "reason": "No dedicated AUMARA Cesium ion session token. Library defaultAccessToken is present and createGooglePhotorealistic3DTileset() returns 401. Google Photorealistic access is not enabled for the available token.",
  "token_requirements": {
    "type": "dedicated AUMARA application token",
    "scopes": "minimum public scopes only",
    "allowed_urls": [
      "https://elcidspain.github.io/aumara/",
      "https://aumara.me/"
    ],
    "never": [
      "print",
      "commit",
      "?ion=",
      "public page URL"
    ]
  }
}
